{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "gemini-quota-retry",
            "type": "command",
            "command": "node ${extensionPath}${/}scripts${/}gemini-quota-retry.js",
            "timeout": 100000,
            "description": "Wait 70 seconds and retry after quota errors"
          }
        ]
      }
    ]
  }
}