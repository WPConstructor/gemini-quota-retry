{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "quota-auto-retry",
            "type": "command",
            "command": "node ${extensionPath}${/}hooks${/}quota-retry.mjs",
            "timeout": 90000,
            "description": "Wait 70 seconds and retry after quota errors"
          }
        ]
      }
    ]
  }
}